# ==========================================================================
# iptvabonnementfrance.store — configuration serveur
# RENOMMER CE FICHIER EN « .htaccess » APRÈS L'UPLOAD SUR cPanel
# (le point initial est retiré ici pour que le fichier reste visible)
# ==========================================================================

Options -Indexes
DirectoryIndex index.html

# ---------------------------------------------------------- HTTPS + www --
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Forcer HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # Sans www (canonique)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # Retirer index.html des URL
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^(.*)index\.html$ /$1 [R=301,L]

  # Ajouter la barre oblique finale sur les dossiers
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [R=301,L]

  # Bloquer les URL de spam classiques
  RewriteRule ^(wp-admin|wp-login|xmlrpc|wp-content|wp-includes|cgi-bin)(/|\.php).*$ - [G,L]
</IfModule>

# ------------------------------------------------------------ Compression --
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml image/svg+xml
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css application/javascript image/svg+xml
</IfModule>

# ------------------------------------------------------------ Cache ------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType image/webp              "access plus 6 months"
  ExpiresByType image/png               "access plus 6 months"
  ExpiresByType image/jpeg              "access plus 6 months"
  ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # En-têtes de sécurité
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ------------------------------------------------------------ Types ------
AddType image/svg+xml .svg
AddType application/manifest+json .webmanifest
AddDefaultCharset UTF-8

# ------------------------------------------------------------ Erreurs ----
ErrorDocument 404 /404.html
